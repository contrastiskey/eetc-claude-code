{
  "description": "Trim pytest / Django / Maven / cargo test output to failures + summary",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/filter-test-output.sh\""
          }
        ]
      }
    ]
  }
}
